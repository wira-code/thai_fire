<div class="container my-5">
  <div class="card p-4 border-0 shadow-sm rounded-4 mb-4">
    <!--<h3 class="fw-bold text-danger mb-3">คำสั่งซื้อ ##<%= @order.id %></h3>-->
    <h2>Order No.<%= @order.order_number%></h2>
    <p class="mb-1"><strong>Status:</strong> <span class="badge bg-warning text-dark"><%= @order.status.titleize %></span></p>
    <p class="mb-1"><strong>Customer Name:</strong> <%= @order.customer_name %></p>
    <p class="mb-1"><strong>Telephone:</strong> <%= @order.phone_number %></p>
    <% if @order.delivery_address.present? && !@order.cash_on_pickup? %>
      <p class="mb-1"><strong>Address:</strong> <%= @order.delivery_address %></p>
    <% end %>
    <p class="mb-1"><strong>Date & Time:</strong>
      <% if @order.delivery_time.present? %>
        <%= @order.delivery_time.in_time_zone.strftime("%d-%m-%Y (%l:%M%p )") %>
      <% else %>
        <%= @order.created_at.strftime("%d-%m-%Y %l.%M%p") %>
      <% end %></p>
    <!--<p class="mb-0"><strong>ราคารวมทั้งสิ้น:</strong> <%= number_to_currency(@order.total_price, unit: "€") %></p> -->
    <p class="mb-1">
    <strong>Total Price:</strong>
    <span class="text-danger fw-bold">€<%= sprintf("%.2f", @order.total_cents / 100.0) %></span>
    </p>
  </div>

  <%# 1. กรณีเลือก Bank Transfer: แสดง QR Code และฟอร์มอัปโหลดสลิป %>
  <% if @order.bank_transfer? %>
    <div class="card p-4 border-0 shadow-sm rounded-4 text-center">
      <h4 class="fw-bold mb-3">สแกน QR Code เพื่อชำระเงิน</h4>

      <!-- ใส่รูป QR Code ของร้าน -->
      <div class="my-3">
        <% if Rails.application.assets.load_path.find("promptpay_qr.png") %>
          <%= image_tag "promptpay_qr.png", class: "img-fluid rounded-3 border shadow-sm", style: "max-width: 250px;" %>
        <% else %>
          <div class="p-4 border bg-light text-muted d-inline-block rounded-3">
            <i class="bi bi-qr-code fs-1"></i>
            <p class="mb-0 mt-2">ยังไม่ได้ใส่รูป QR Code</p>
          </div>
        <% end %>
      </div>

      <p class="text-muted">ธนาคาร: XXX | เลขที่บัญชี: xxx-x-xxxxx-x | ชื่อบัญชี: Thai Fire Restaurant</p>

      <hr class="my-4">

      <h5 class="fw-bold mb-3">อัปโหลดสลิปการโอนเงิน</h5>
      <%= form_with model: @order, url: upload_slip_order_path(@order), method: :patch, local: true do |f| %>
        <div class="mb-3 w-50 mx-auto">
          <%= f.file_field :payment_slip, class: "form-control", required: true %>
        </div>
        <%= f.submit "ยืนยันการแจ้งโอนเงิน", class: "btn btn-danger rounded-pill px-4" %>
      <% end %>
    </div>

  <%# 2. กรณีเลือก Stripe: แสดงสถานะการชำระเงิน %>
  <% elsif @order.stripe? %>
    <% if params[:success].present? || @order.status == 'paid' %>
      <div class="alert alert-success text-center my-4 p-4">
        <i class="bi bi-check-circle-fill text-success fs-1"></i>
        <h3 class="mt-2 text-success fw-bold">ชำระเงินผ่านบัตรเรียบร้อยแล้ว</h3>
        <p class="mb-0 text-muted">ทางร้านกำลังเตรียมรายการอาหารของคุณ</p>
      </div>
    <% elsif params[:cancel].present? %>
      <div class="alert alert-warning text-center my-4 p-3">
        <h4 class="fw-bold">การชำระเงินถูกยกเลิก</h4>
        <p class="mb-0">คุณยังไม่ได้ทำรายการชำระเงิน กรุณาลองใหม่อีกครั้ง</p>
      </div>
    <% else %>
      <div class="alert alert-info text-center my-4 p-3">
        <p class="mb-0">รอการยืนยันการชำระเงินจากระบบ</p>
      </div>
  <% end %>
    <!--<div class="card p-4 border-0 shadow-sm rounded-4 text-center">
      <h4 class="fw-bold text-success mb-3"><i class="bi bi-check-circle-fill me-2"></i>ชำระเงินผ่านบัตรเรียบร้อยแล้ว</h4>
      <p class="text-muted mb-0">ทางร้านกำลังเตรียมรายการอาหารของคุณ</p>
    </div>-->

  <%# 3. กรณีเลือก Cash on Pickup: แสดงคำแนะนำ %>
  <% elsif @order.cash_on_pickup? %>
    <div class="card border-warning mb-4 shadow-sm">
      <div class="card-body text-center p-4">
        <div class="mb-2">
          <i class="bi bi-shop text-warning" style="font-size: 2.5rem;"></i>
        </div>
        <h4 class="fw-bold text-dark">ชำระเงินสดที่หน้าร้าน (Pay on Pickup)</h4>
        <p class="mb-3">
          ยอดที่ต้องชำระ: <strong class="text-danger fs-4">€<%= sprintf("%.2f", (@order.total_cents || 0) / 100.0) %></strong>
        </p>
        <p class="text-muted mb-3">ทางร้านได้รับออเดอร์แล้ว กำลังเตรียมรายการอาหารของคุณ</p>

        <div class="p-3 bg-light rounded-3 text-start d-inline-block border">
          <p class="mb-1 text-secondary">
            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
            <strong>สถานที่รับอาหาร:</strong> ร้าน Thai Fire
          </p>
          <p class="mb-0 text-secondary">
            <i class="bi bi-clock-fill text-primary me-1"></i>
            <strong>เวลารับอาหาร:</strong>
            <% if @order.delivery_time.present? %>
            <%= @order.delivery_time.in_time_zone.strftime("%d-%m-%Y (%l:%M %p)") %>
            <% else %>
              ส่งทันที / ตามเวลาที่ระบุ
            <% end %>
          </p>
        </div>
      </div>
    </div>
    <!--<div class="card p-4 border-0 shadow-sm rounded-4 text-center">
      <h4 class="fw-bold text-primary mb-3"><i class="bi bi-shop me-2"></i>ชำระเงินสดหน้าร้าน</h4>
      <p class="text-muted mb-0">กรุณาแจ้งเลขที่คำสั่งซื้อ ##<%= @order.id %> กับพนักงานเมื่อมารับอาหาร</p>
    </div>-->
  <% end %>
</div>
