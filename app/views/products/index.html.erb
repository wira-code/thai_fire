<h1>Products#index</h1>
<p>Find me in app/views/products/index.html.erb</p>

<div class="container my-4">
  <!-- แถบเลือกหมวดหมู่สินค้า (Category Filter) -->
  <div class="d-flex gap-2 mb-4 overflow-auto pb-2">
    <%= link_to "ทั้งหมด", products_path, class: "btn #{params[:category_id].blank? ? 'btn-primary' : 'btn-outline-primary'}" %>
    <% @categories.each do |category| %>
      <%= link_to category.name, products_path(category_id: category.id),
                  class: "btn #{params[:category_id].to_i == category.id ? 'btn-primary' : 'btn-outline-primary'}" %>
    <% end %>
  </div>

  <!-- รายการสินค้า (Product Cards Grid) -->
  <div class="row row-cols-1 row-cols-md-3 g-4">
    <% @products.each do |product| %>
      <div class="col">
        <div class="card h-100 shadow-sm">
          <% if product.image_url.present? %>
            <img src="<%= product.image_url %>" class="card-img-top" alt="<%= product.name %>" style="height: 200px; object-fit: cover;">
          <% else %>
            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
              <span class="text-muted">ไม่มีรูปภาพ</span>
            </div>
          <% end %>

          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= product.name %></h5>
            <p class="card-text text-muted flex-grow-1"><%= truncate(product.description, length: 80) %></p>

            <div class="d-flex justify-content-between align-items-center mt-3">
              <span class="fw-bold fs-5 text-primary">
                ฿<%= sprintf('%.2f', product.price_cents / 100.0) %>
              </span>
              <%= link_to "ดูรายละเอียด", product_path(product), class: "btn btn-outline-primary btn-sm" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
