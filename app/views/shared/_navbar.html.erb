
<nav class="navbar navbar-expand-lg navbar-light bg-secondary-subtle border-bottom sticky-top py-1">
  <div class="container-fluid px-4">

    <!-- 1. LOGO ทางซ้าย -->
    <%= link_to root_path, class: "navbar-brand d-flex align-items-center me-4 text-decoration-none" do %>
    <%= image_tag "logo.jpeg", alt: "Thai Fire Logo", class: "img-fluid rounded-4 shadow-sm", style: "height: 70px; width: auto object-fit: cover;" %>

    <% end %>

    <!-- ปุ่ม Hamburger บนมือถือ -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- 2. เมนูตรงกลาง (สไตล์ภาพที่ 2) -->
    <div class="collapse navbar-collapse" id="mainNavbar">
      <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2 align-items-center text-nowrap">
        <li class="nav-item">
          <%= link_to "HOME", root_path, class: "nav-link px-3 fw-bold text-white bg-danger rounded-0 #{'active' if current_page?(root_path)}", style: "background-color: #b81c24 !important;" %>
        </li>
        <% Category.where(active: true).order(:position).each do |category| %>
          <li class="nav-item">
            <%= link_to category.name.upcase, category_path(category), class: "nav-link px-3 fw-bold text-nowrap #{'active' if current_page?(category_path(category))}" %>
          </li>
        <% end %>
        <li class="nav-item">
          <%= link_to "CONTACT", contact_path, class: "nav-link px-3 fw-bold text-dark #{'active' if current_page?(contact_path)}" %>
        </li>
      </ul>

      <!-- 3. ปุ่มขวาสุด (ปุ่ม RESERVE ขอบมนสีแดง) -->
      <div class="d-flex align-items-center gap-2">
        <!-- ปุ่ม Action ขวาสุดตามภาพที่ 2 -->
        <%= link_to reserve_path, class: "btn btn-outline-danger fw-bold rounded-pill px-3 py-2 ms-2", style: "color: #b81c24; border-color: #b81c24;" do %>
          📅 RESERVE
        <% end %>

        <!-- ปุ่ม ตะกร้าสินค้า -->
<%= link_to cart_path, class: "btn btn-outline-danger rounded-pill" do %>
  🛒 ตะกร้า <span class="badge bg-danger"><%= current_cart.cart_items.sum(:quantity) %></span>
<% end %>
<!--
<a href="<%= cart_path %>" class="btn btn-outline-danger rounded-pill">
  🛒 ตะกร้า <span class="badge bg-danger"><%= current_cart.cart_items.sum(:quantity) %></span>
</a> -->


        <!-- เช็กการ Sign in ของ Devise -->
        <% if user_signed_in? %>
          <%= link_to "ออกจากระบบ", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-link text-muted text-decoration-none btn-sm" %>
        <% else %>
          <%= link_to "Log in", new_user_session_path, class: "btn btn-link text-muted text-decoration-none fw-bold text-dark btn-sm" %>
        <% end %>
      </div>
    </div>

  </div>
</nav>
