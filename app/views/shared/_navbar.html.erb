<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top py-3">
  <div class="container-fluid px-4">
    <!-- 1. โลโก้แบรนด์ทางซ้าย -->
    <%= link_to root_path, class: "navbar-brand d-flex align-items-center me-4" do %>
      <div class="text-center">
        <div class="bg-danger text-white fw-bold px-2 py-1 rounded-top small">LOGO</div>
        <span class="fw-bold text-dark tracking-wider d-block" style="font-size: 1.1rem; line-height: 1.1;">STORE NAME</span>
      </div>
    <% end %>

    <!-- ปุ่ม Hamburger สำหรับ Mobile -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- 2. เมนูตรงกลาง -->
    <div class="collapse navbar-collapse" id="mainNavbar">
      <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-3">
        <li class="nav-item">
          <%= link_to "HOME", root_path, class: "nav-link px-3 fw-bold #{'active text-white bg-danger rounded' if current_page?(root_path)}" %>
        </li>
        <li class="nav-item">
          <%= link_to "MENU", products_path, class: "nav-link px-3 fw-bold #{'active text-white bg-danger rounded' if current_page?(products_path)}" %>
        </li>
        <li class="nav-item">
          <%= link_to "ABOUT", "#", class: "nav-link px-3 fw-bold text-dark" %>
        </li>
        <li class="nav-item">
          <%= link_to "OUR BRANCH", "#", class: "nav-link px-3 fw-bold text-dark" %>
        </li>
        <li class="nav-item">
          <%= link_to "CONTACT", "#", class: "nav-link px-3 fw-bold text-dark" %>
        </li>
      </ul>

      <!-- 3. ส่วนทางขวา (ตะกร้าสินค้า, ปุ่ม Login/User, ปุ่ม Action) -->
      <div class="d-flex align-items-center gap-3">
        <!-- ไอคอนตะกร้าสินค้า ( Cart ) -->
        <%= link_to cart_path, class: "btn btn-outline-dark position-relative rounded-pill px-3" do %>
          🛒 ตะกร้า
          <% if current_cart.cart_items.any? %>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
              <%= current_cart.cart_items.sum(:quantity) %>
            </span>
          <% end %>
        <% end %>

        <!-- เช็กสถานะ Devise Authentication -->
        <% if user_signed_in? %>
          <div class="dropdown">
            <button class="btn btn-light dropdown-toggle fw-bold" type="button" data-bs-toggle="dropdown">
              👤 <%= current_user.first_name.presence || current_user.email %>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><%= link_to "ประวัติการสั่งซื้อ", orders_path, class: "dropdown-item" %></li>
              <li><%= link_to "แก้ไขข้อมูลส่วนตัว", edit_user_registration_path, class: "dropdown-item" %></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= link_to "ออกจากระบบ", destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item text-danger" %>
              </li>
            </ul>
          </div>
        <% else %>
          <%= link_to "เข้าสู่ระบบ", new_user_session_path, class: "btn btn-outline-secondary fw-bold rounded-pill px-3" %>
        <% end %>

        <!-- ปุ่ม Highlight หลักทางขวาสุด (เช่น สั่งอาหาร / จองโต๊ะ) -->
        <%= link_to products_path, class: "btn btn-outline-danger fw-bold rounded-pill px-3 py-2" do %>
          📅 ORDER NOW
        <% end %>
      </div>
    </div>
  </div>
</nav>
