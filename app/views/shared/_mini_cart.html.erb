<div id="sidebar-cart" class="mini-cart-sidebar shadow-lg">
  <div class="mini-cart-header p-3 text-center border-bottom bg-dark text-white fw-bold">
    PANIER (ตะกร้าสินค้า)
  </div>

  <div class="mini-cart-body p-3 overflow-auto" style="max-height: 400px;">
    <% if @cart_items.present? && @cart_items.any? %>
      <% @cart_items.each do |item| %>
        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom text-white">
          <div class="d-flex align-items-center gap-2">
            <div class="d-flex align-items-center bg-secondary rounded p-1 gap-1">
              <%= button_to decrease_cart_item_path(item), method: :post, class: "btn btn-sm btn-outline-light p-0 px-1 border-0 fw-bold", style: "line-height: 1;" do %>
                -
              <% end %>

              <span class="fw-bold text-warning small px-1"><%= item.quantity %></span>

              <%= button_to increase_cart_item_path(item), method: :post, class: "btn btn-sm btn-outline-light p-0 px-1 border-0 fw-bold", style: "line-height: 1;" do %>
                +
              <% end %>
            </div>
            <% if item.product.image_url.present? %>
              <%= image_tag item.product.image_url, class: "rounded", style: "width: 45px; height: 45px; object-fit: cover;" %>
            <% else %>
              <div class="bg-secondary rounded d-flex align-items-center justify-content-center text-white" style="width: 45px; height: 45px;">📷</div>
            <% end %>
            <div>
              <div class="fw-semibold text-truncate text-white" style="max-width: 120px;"><%= item.product.name %></div>
            </div>
          </div>
          <div class="fw-bold text-end text-white">
            €<%= number_with_precision((item.product.price_cents * item.quantity) / 100.0, precision: 2) %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="text-center text-muted py-4">ไม่มีสินค้าในตะกร้า</div>
    <% end %>
  </div>

  <div class="mini-cart-footer p-3 border-top bg-dark text-white">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <span class="fs-5">Total</span>
      <span class="fs-4 fw-bold text-warning">
        €<%= number_with_precision((@cart_items&.sum { |i| i.product.price_cents * i.quantity } || 0) / 100.0, precision: 2) %>
      </span>
    </div>
    <%= link_to "COMMANDER (สั่งซื้อ)", new_order_path, class: "btn btn-warning w-100 fw-bold py-2 text-dark text-uppercase" %>
  </div>
</div>
