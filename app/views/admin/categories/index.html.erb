
<div class="container my-4" style="max-width: 900px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">📁 Category Management</h2>
    <%= link_to "← Back to Menu management", admin_products_path, class: "btn btn-outline-secondary rounded-3" %>
  </div>

  <div class="row g-4">
    <%# ตารางแสดงรายการ Categories %>
    <div class="col-md-7">
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="transform: none !important; transition: none !important;">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-dark">
            <tr>
              <th>#</th>
              <th>Category Name</th>
              <th class="text-center">Total Menu</th>
              <th class="text-end">Management</th>
            </tr>
          </thead>
          <tbody>
            <% @categories.each_with_index do |category, index| %>
              <tr>
                <td><%= index + 1 %></td>
                <td class="fw-bold"><%= category.name %></td>
                <td class="text-center"><span class="badge bg-info text-dark"><%= category.respond_to?(:products) ? category.products.count : 0 %></span></td>
                <td class="text-end">
                  <%= button_to "ลบ", admin_category_path(category), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-outline-danger", form_class: "d-inline-block" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# ฟอร์มเพิ่ม Category %>
    <div class="col-md-5">
      <div class="card border-0 shadow-sm rounded-4 p-4" style="transform: none !important; transition: none !important;">
        <h4 class="fw-bold mb-3">➕ New Category</h4>

        <%= form_with model: [:admin, @category], local: true do |f| %>
          <% if @category.errors.any? %>
            <div class="alert alert-danger rounded-3">
              <ul class="mb-0 ps-3">
                <% @category.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= f.label :name, "Category Name", class: "form-label fw-bold" %>
            <%= f.text_field :name, class: "form-control rounded-3", placeholder: "e.g. Appetizers, Drinks", required: true %>
          </div>

          <%= f.submit "Submit", class: "btn btn-danger fw-bold rounded-3 w-100" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
