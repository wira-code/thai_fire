
<div class="container py-3">
  <div class="row justify-content-center">
    <div class="col-md-9">
      <%= link_to "← Back to Options management", admin_options_path, class: "btn btn-outline-secondary rounded-3 mb-3" %>
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h3 class="fw-bold mb-4">➕ New Option</h3>
          <%= render "form", option: @option %>
        </div>
      </div>
    </div>
  </div>
</div>
