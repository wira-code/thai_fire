
<div class="container my-4" style="max-width: 700px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">📅 Reservation Details #<%= @reservation.id %></h3>
    <%= link_to "← Back to Reservations", admin_reservations_path, class: "btn btn-outline-secondary rounded-3" %>
  </div>

  <div class="card border-0 shadow-sm rounded-4 p-4" style="transform: none !important; transition: none !important;">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">

      <div class="text-start">
        <small class="text-muted d-block">Booking Created At</small>
        <strong><%= @reservation.created_at.strftime("%d/%m/%Y - %I:%M %p") %></strong>
      </div>
      <div class="text-center">
        <small class="text-muted d-block">Status</small>
          <%# 🟢 แปลงค่าสถานะให้แสดงผลภาษาไทย/อังกฤษ และใส่สีตาม Helper %>
          <% status_text = case @reservation.status.to_s.downcase
            when 'pending', 'true' then '⏳ Pending'
            when 'confirmed'      then '✅ Confirmed'
            when 'completed'      then '🏁 Completed'
            when 'cancelled', 'false' then '❌ Cancelled'
            else @reservation.status.to_s.upcase
            end %>
        <span class="badge px-3 py-2 rounded-pill fw-bold
          <%= reservation_status_badge_class(@reservation.status) %>">
          <%= status_text %>
        </span>
      </div>
    </div>

    <div class="row g-3">
      <div class="col-6">
        <small class="text-muted d-block">Customer Name</small>
        <h5 class="fw-bold"><%= @reservation.try(:name) || @reservation.user.try(:first_name) || "Guest" %></h5>
      </div>
      <div class="col-6">
        <small class="text-muted d-block">Phone / Contact</small>
        <h5 class="fw-bold"><%= @reservation.try(:phone) || "ไม่ระบุ" %></h5>
      </div>
      <div class="col-6">
        <small class="text-muted d-block">Date</small>
        <h5 class="fw-bold"><%= @reservation.try(:reservation_date)&.strftime("%d/%m/%Y") || "-" %></h5>
      </div>
      <div class="col-6">
        <small class="text-muted d-block">Time</small>
        <h5 class="fw-bold"><%= @reservation.try(:reservation_time)&.strftime("%I:%M %p") || "-" %></h5>
      </div>
      <div class="col-12">
        <small class="text-muted d-block">Number of Guests</small>
        <h5 class="fw-bold"><%= @reservation.try(:guests_count) || @reservation.try(:party_size) || 1 %> ท่าน</h5>
      </div>

      <% if @reservation.respond_to?(:special_request) && @reservation.special_request.present? %>
        <div class="col-12 mt-3 pt-3 border-top">
          <small class="text-muted d-block">Special Request / คำขอเพิ่มเติม</small>
          <p class="p-3 bg-light rounded-3 mb-0"><%= @reservation.special_request %></p>
        </div>
      <% end %>
    </div>
    <div class="col-12 mt-3 pt-3 border-top fw-bold">
        <small class="text-muted d-block mb-1">Special Request</small>
        <% req_text = @reservation.try(:special_request) || @reservation.try(:note) || @reservation.try(:notes) %>
        <% if req_text.present? %>
          <div class="p-3 bg-light rounded-3 fw-semibold text-dark">
            <%= req_text %>
          </div>
        <% else %>
          <div class="p-3 bg-light rounded-3 text-muted fst-italic">
            No special request !
          </div>
        <% end %>
      </div>
  </div>
</div>
