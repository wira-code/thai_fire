<h1>Admin::Products#index</h1>
<p>Find me in app/views/admin/products/index.html.erb</p>

<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">🍔 จัดการเมนูอาหาร (Admin Menu)</h2>
    <%= link_to "+ เพิ่มเมนูใหม่", new_admin_product_path, class: "btn btn-danger fw-bold rounded-3" %>
  </div>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th>รูปภาพ</th>
            <th>ชื่อเมนู</th>
            <th>หมวดหมู่</th>
            <th>ราคา</th>
            <th class="text-end">จัดการ</th>
          </tr>
        </thead>
        <tbody>
          <% @products.each do |product| %>
            <tr>
              <td style="width: 80px;">
                <% if product.image_url.present? %>
                  <%= image_tag product.image_url, class: "rounded-3", style: "width: 50px; height: 50px; object-fit: cover;" %>
                <% else %>
                  <div class="bg-secondary text-white rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">📷</div>
                <% end %>
              </td>
              <td class="fw-bold"><%= product.name %></td>
              <td><span class="badge bg-secondary"><%= product.category || 'ทั่วไป' %></span></td>
              <td class="fw-bold text-danger">€<%= number_with_precision(product.price_cents / 100.0, precision: 2) %></td>
              <td class="text-end">
                <%= link_to "แก้ไข", edit_admin_product_path(product), class: "btn btn-sm btn-outline-primary me-1" %>
                <%= button_to "ลบ", admin_product_path(product), method: :delete, data: { turbo_confirm: "ยืนยันการลบเมนูนี้?" }, class: "btn btn-sm btn-outline-danger d-inline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
