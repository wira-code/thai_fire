<%= form_with(model: [:admin, add_on], local: true) do |f| %>
  <% if add_on.errors.any? %>
    <div class="alert alert-danger">
      <h6 class="alert-heading"><%= pluralize(add_on.errors.count, "error") %> prohibited this add-on from being saved:</h6>
      <ul class="mb-0">
        <% add_on.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, "Add-on name", class: "form-label fw-bold" %>
    <%= f.text_field :name, class: "form-control", placeholder: "Fried Egg", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :description, "Description", class: "form-label fw-bold" %>
    <%= f.text_area :description, class: "form-control", rows: 2, placeholder: "Crispy egg fried" %>
  </div>

  <div class="mb-3">
    <%= f.label :price_cents, "Price on Cents (200 = €2.00)", class: "form-label fw-bold" %>
    <%= f.number_field :price_cents, class: "form-control", placeholder: "200", required: true %>
    <!--<div class="form-text">price on Cent</div>-->
  </div>

  <div class="mb-4 form-check form-switch">
    <%= f.check_box :available, class: "form-check-input", id: "addOnAvailableCheck" %>
    <%= f.label :available, "Available", class: "form-check-label fw-bold", for: "addOnAvailableCheck" %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit "Submit", class: "btn btn-danger" %>
    <%= link_to "Cancle", admin_add_ons_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
