
<div class="container py-3">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">🍳 Add-ons Management (Topping)</h2>
    <%= link_to "+ New Add-on", new_admin_add_on_path, class: "btn btn-danger" %>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Add-on Name</th>
              <th>Description</th>
              <th>Price (€)</th>
              <th>Status</th>
              <th class="text-end pe-4">จัดการ</th>
            </tr>
          </thead>
          <tbody>
            <% if @add_ons.any? %>
              <% @add_ons.each do |add_on| %>
                <tr>
                  <td class="ps-4 fw-bold"><%= add_on.name %></td>
                  <td class="text-muted"><%= add_on.description.presence || "-" %></td>
                  <td class="fw-bold text-danger">
                    €<%= sprintf("%.2f", (add_on.price_cents || 0) / 100.0) %>
                  </td>
                  <td>
                    <% if add_on.available %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle">Available</span>
                    <% else %>
                      <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Out of stock</span>
                    <% end %>
                  </td>
                  <td class="text-end pe-4">
                    <%= link_to "Edit", edit_admin_add_on_path(add_on), class: "btn btn-sm btn-outline-primary me-1" %>
                    <%= link_to "Delete", admin_add_on_path(add_on), data: { turbo_method: :delete, turbo_confirm: "Are you sure to delete this Add-on?" }, class: "btn btn-sm btn-outline-danger" %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" class="text-center py-4 text-muted">No Add-on in system</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
