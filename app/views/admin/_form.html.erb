<%= form_with model: [:admin, product], local: true do |f| %>
  <% if product.errors.any? %>
    <div class="alert alert-danger rounded-3">
      <ul class="mb-0 ps-3">
        <% product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, "ชื่อเมนู", class: "form-label fw-bold" %>
    <%= f.text_field :name, class: "form-control rounded-3", required: true %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :category, "หมวดหมู่ (เช่น Starters, Main Dishes, Soups)", class: "form-label fw-bold" %>
      <%= f.text_field :category, class: "form-control rounded-3" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :price_cents, "ราคา (หน่วย Cents เช่น 10.00 ให้ใส่ 1000)", class: "form-label fw-bold" %>
      <%= f.number_field :price_cents, class: "form-control rounded-3", required: true %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :image_url, "URL รูปภาพเมนู", class: "form-label fw-bold" %>
    <%= f.text_field :image_url, class: "form-control rounded-3", placeholder: "https://..." %>
  </div>

  <div class="mb-3">
    <%= f.label :description, "รายละเอียดเมนู", class: "form-label fw-bold" %>
    <%= f.text_area :description, rows: 3, class: "form-control rounded-3" %>
  </div>

  <div class="d-flex gap-2 pt-2">
    <%= f.submit product.persisted? ? "บันทึกการแก้ไข" : "สร้างเมนูใหม่", class: "btn btn-danger fw-bold rounded-3 px-4" %>
    <%= link_to "ยกเลิก", admin_products_path, class: "btn btn-outline-secondary rounded-3 px-4" %>
  </div>
<% end %>
