
<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">📦 Order Management</h2>
    <%= link_to "← Back to Menu Management", admin_products_path, class: "btn btn-outline-secondary rounded-3" %>
  </div>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="transform: none !important; transition: none !important;">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th># Order Number</th>
            <th>Date / Time</th>
            <th>Customer</th>
            <th>Total Price</th>
            <th class="text-center">Order status</th>
            <th class="text-center">Management</th>
          </tr>
        </thead>
        <tbody>
          <% if @orders.any? %>
            <% @orders.each do |order| %>
              <tr>
                <td class="fw-bold">#<%= order.order_number %></td>
                <td><%= order.created_at.strftime("%d/%m/%Y - %I:%M %p") %> น.</td>
                <td>
                  <div class="fw-semibold">
                    <%= order.user.try(:first_name) || order.user.try(:name) || order.user.try(:username) || order.try(:customer_name) || "ไม่ระบุชื่อ" %>
                  </div>
                  <small class="text-muted"><%= order.try(:phone) || order.try(:email) %></small>
                </td>
                <td class="fw-bold text-danger">
                  €<%= number_with_precision((order.try(:total_price_cents) || order.try(:total_price) || 0), precision: 2) %>
                </td>

                <%# 🟢 Badge สถานะ และ Form เปลี่ยนสถานะแบบรวดเร็ว %>
                <td class="text-center">
                  <%= form_with model: [:admin, order], local: true, class: "d-inline-block" do |f| %>
                    <%= f.select :status,
                        [
                          ["⏳ รอดำเนินการ (Pending)", "pending"],
                          ["🍳 กำลังปรุง (Preparing)", "preparing"],
                          ["✅ เสร็จสิ้น (Completed)", "completed"],
                          ["❌ ยกเลิก (Cancelled)", "cancelled"]
                        ],
                        {},
                        { class: "form-select form-select-sm rounded-3 border-secondary fw-semibold", onchange: "this.form.submit()" } %>
                  <% end %>
                </td>

                <td class="text-end">
                  <%= link_to "Details", admin_order_path(order), class: "btn btn-sm btn-outline-dark rounded-3 me-4" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="text-center py-4 text-muted">ยังไม่มีรายการสั่งซื้อเข้ามา</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
